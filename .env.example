# 이 파일을 복사해 .env 를 만들고 실제 값을 넣으세요. (.env 는 GitHub에 올라가지 않습니다)
# 자세한 방법: docs/supabase-setup.md

# Supabase > Project Settings > API 의 Project URL
VITE_SUPABASE_URL=
# Supabase의 anon(public) 키. service_role(secret) 키는 절대 넣지 마세요.
VITE_SUPABASE_ANON_KEY=
# (선택) Formspree 폼 ID. 비우면 B1-1에서 쓰던 공개 폼 ID를 사용합니다.
VITE_FORMSPREE_ID=
